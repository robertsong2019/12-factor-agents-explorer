    "keyDecisions": [
      "Span 采用栈式管理而非 Map，因为 Agent 执行天然是嵌套的",
      "PolicyEngine 用 Map<category, Rule[]> 而非扁平列表，因为策略需要按场景分组",
      "Evaluator 使用可插拔检查函数而非硬编码维度，支持灵活扩展",
      "内置规则通过工厂函数从 JSON 动态构建，实现配置驱动的安全策略"
    ],
    "entryPoint": "src/index.ts 是唯一的外部入口，barrel 模式简化导入",
    "testStrategy": "按模块分文件 + 集成测试 + 每轮 autoresearch 新增 cycle N 测试"
  },
  "dependencyGraph": {
    "src/tracer.ts": { "internal": [], "external": ["node:crypto"] },
    "src/policy-engine.ts": { "internal": [], "external": [] },
    "src/evaluator.ts": { "internal": ["src/tracer.ts"], "external": [] },
    "src/index.ts": { "internal": ["src/tracer.ts", "src/policy-engine.ts", "src/evaluator.ts"], "external": [] }
  }
}
